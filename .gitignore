# deps / build
node_modules/
src-tauri/target/
src-tauri/gen/
dist/*
!dist/README.md
*.o
*.rlib
# 资源对象（manifest+图标+版本信息）由 scripts/build.ps1 从 src-tauri/resource.rc 现场生成。
# 不入库的理由：二进制不会跟着版本号变（曾出现 exe 是 0.9.3 而源码 0.9.5 的漂移），
# 且别人 clone 拿到的是别人机器的产物。事实源是 resource.rc（文本），那个才入库。

# release artifacts (走 GitHub Release，不进仓库)
release/

# secrets / runtime data
config.json
auths/
data/
*.axiao-bak
*.json.axiao-bak
*.log

# vendored repos (fetch with scripts/fetch-vendor.ps1)
vendor/
fusion/vendor/

# AI 工作区（过程产物，不入库）
AI工作区/

# binaries
*.exe
*.msi
*.dmg
*.AppImage
!third_party/**/README*

# editor
.vscode/
.idea/
.DS_Store
