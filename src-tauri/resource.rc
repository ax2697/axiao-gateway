1 24 "app.manifest"
1 ICON "icons/icon.ico"

// 版本信息。没有它，exe 右键属性里版本/产品名/公司全是空的 —— 用户
// 看到一个空白属性的程序，第一反应是"这东西来路不明"。
// 改版本号要同时改这里、Cargo.toml、tauri.conf.json 三处。
1 VERSIONINFO
FILEVERSION 0,9,3,0
PRODUCTVERSION 0,9,3,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "Axiao AI"
            VALUE "FileDescription", "Axiao Gateway"
            VALUE "FileVersion", "0.9.3"
            VALUE "InternalName", "axiao-gateway"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "axiao-gateway.exe"
            VALUE "ProductName", "Axiao Gateway"
            VALUE "ProductVersion", "0.9.3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
